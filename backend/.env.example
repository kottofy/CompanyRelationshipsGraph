# .env.example for CompanyGraph Backend

# Azure Open AI settings (replace with your actual values)
AZURE_OPENAI_ENDPOINT=https://your-azure-endpoint
AZURE_OPENAI_KEY=xxxxxxxx

# Azure AI Agent settings (replace with your actual values)
AZURE_AI_AGENT_ENDPOINT=https://your-azure-endpoint
AZURE_AI_AGENT_AGENT_ID=your-agent-id